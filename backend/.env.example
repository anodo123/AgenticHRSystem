# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
APP_NAME=DARWINBOXAI
API_V1_STR=/api/v1
APP_DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# ---------------------------------------------------------------------------
# Database / vector storage
# PostgreSQL is required for the Docker/runtime architecture. pgvector is
# enabled by migration 001. Never use production credentials in this file.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/darwinboxai
DATABASE_ECHO=false
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=hashed-token-v1
EMBEDDING_DIMENSION=128

# ---------------------------------------------------------------------------
# Authentication and application secrets
# Replace these placeholders for every non-local environment.
# ---------------------------------------------------------------------------
SECRET_KEY=replace-with-a-random-application-secret
JWT_SECRET_KEY=replace-with-a-random-jwt-secret-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# OpenAI LLM
# OPENAI_API_KEY is required at runtime. The application has no mock LLM
# fallback and /ready returns 503 when the key is absent.
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5.6-sol
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_MAX_OUTPUT_TOKENS=2000
LLM_REASONING_EFFORT=medium

# ---------------------------------------------------------------------------
# Workflow, approval, RAG, and incident memory
# ---------------------------------------------------------------------------
WORKFLOW_MAX_RETRIES=3
WORKFLOW_TIMEOUT_SECONDS=3600
APPROVAL_EXPIRY_HOURS=48
DATA_FRESHNESS_MAX_AGE_MINUTES=30
POLICY_TOP_K=5
POLICY_MIN_SCORE=0.3
POLICY_CHUNK_SIZE=500
POLICY_CHUNK_OVERLAP=100
INCIDENT_TOP_K=3
INCIDENT_MIN_SCORE=0.4

# ---------------------------------------------------------------------------
# Scheduling / queue / cache
# APScheduler runs inside FastAPI. No Redis, external cache, or queue is used.
# ---------------------------------------------------------------------------
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# ---------------------------------------------------------------------------
# External HR systems
# The current HRIS/payroll/attendance/leave/benefits/LMS adapters use local
# database records. No vendor endpoint credentials are consumed.
# ---------------------------------------------------------------------------
MOCK_HR_ADAPTERS_ENABLED=true

# ---------------------------------------------------------------------------
# Observability and API protection
# Metrics and rate limiting are process-local in this implementation.
# ---------------------------------------------------------------------------
LOG_FORMAT=json
CORRELATION_ID_HEADER=X-Correlation-ID
RATE_LIMITING_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=120

# ---------------------------------------------------------------------------
# Feature flags
# ---------------------------------------------------------------------------
ENABLE_POLICY_RAG=true
ENABLE_INCIDENT_MEMORY=true
ENABLE_AUDIT_LOGGING=true
ENABLE_APPROVALS=true
ENABLE_TASK_SCHEDULING=true
